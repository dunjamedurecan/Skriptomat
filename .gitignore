# .gitignore file se koristi za popis fileova koji se ne prate pomoću gita
# untracked_note.txt je primjer (znači možete imati istoimeni file u radnom folderu ali se on neće slati na GitHub prilikom commitova)
untracked_note.txt

# OS
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
env/
.venv/
venv/
pip-log.txt
pip-delete-this-directory.txt

# Django
db.sqlite3
media/
staticfiles/
*.log

# Virtualenv
.venv/
ENV/
env.bak/
venv.bak/

# Node
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & secrets
.env                    # Local overrides (ignored)
.env.local             # Local secrets (ignored)
.env.*.local           # Local environment-specific (ignored)
secrets.json
backend/.env

# Keep environment templates in Git:
# .env.example           ✅ Tracked
# .env.development       ✅ Tracked (dev config)
# .env.production        ✅ Tracked (prod config)

# IDEs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Testing
.coverage
htmlcov/
.pytest_cache/

# Docker
docker-compose.override.yml

# Misc
*.swp
*.tmp
*.bak
*.dump
test.jsx
test.css

