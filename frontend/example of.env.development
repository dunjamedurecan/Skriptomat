# Development Environment Variables
# Ovaj file se automatski učitava kada pokreneš: npm run dev

# Local backend (Vite proxy)
VITE_API_URL=/api

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID=

# PayPal Client ID (Sandbox for development)
VITE_PAYPAL_CLIENT_ID=

# Firebase Configuration (for chat functionality)
# Get these from: https://console.firebase.google.com/ -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
